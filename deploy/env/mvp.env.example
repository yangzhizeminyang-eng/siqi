# MVP 版本环境模板

APP_ENV=mvp
APP_NAME=enterprise-ai-agent-platform
APP_PORT=8000
PUBLIC_PORT=8001
PUBLIC_BASE_URL=http://<server-ip>:8006
DATABASE_NAME=agent_mvp
REDIS_DB=0
MILVUS_COLLECTION_PREFIX=mvp
# 管理员应急恢复码，必须替换为部署负责人保管的随机高强度值
AUTH_RECOVERY_CODE=replace-with-a-long-random-recovery-code

# ---- 模型接入（可选，Key 留空则回退本地兜底）----
# 文本大模型：DeepSeek。不配置 LLM_API_KEY 时，AI 分析回退规则生成。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
# 向量模型：智谱 embedding-3。不配置 ZHIPU_API_KEY 时，Embedding 回退本地 token-hash。
EMBEDDING_PROVIDER=zhipu
ZHIPU_MODEL=embedding-3
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
EMBEDDING_DIMENSIONS=2048
# 通用模型调用参数
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MOCK_FALLBACK=true   # 仅开发/演示：mock 回退（无真实 LLM Key 时离线可跑）；联调/验收请置 false 走真实模型

# ---- 后端运行时（与 backend/app/core/runtime_config.py 对齐）----
# 数据目录（sqlite/milvus-lite 的默认位置）
DATA_DIR=.data
# SQL 连接串：本地 SQLite 默认；生产 MySQL 例：
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/agent_mvp?charset=utf8mb4
DATABASE_URL=sqlite:///.data/app.db
# 业务持久化总开关（测试关闭；生产开启）
USE_SQLALCHEMY=true
# 写透严格模式：true=写库失败直接上抛（拒绝静默丢数据）；false=失败记日志/指标但不阻断请求（默认）
PERSIST_STRICT=false
# ---- MySQL 生产接入（scripts/init_mysql.py，建库需 CREATE DATABASE 权限）----
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_ADMIN_USER=root
# MYSQL_ROOT_PASSWORD=<仅密管/环境变量注入，勿提交>
# DATABASE_NAME=agent
# Milvus：生产首选；本地默认走 Milvus Lite 文件（DATA_DIR/milvus/code_index.db）
USE_MILVUS=true
# MILVUS_URI=http://<milvus-host>:19530   # 生产远端 Milvus
# MILVUS_TOKEN=<token>
# Milvus 不可用时的降级：true 允许显式降级内存/关键词并标注（测试/本地）；false 失败即抛错（生产）
RAG_MOCK_FALLBACK=true   # 仅开发/演示：Milvus 不可用时显式降级；联调/验收请置 false 走真实 Milvus
# 检索模式：vector=现有向量检索；hybrid=BM25 + 向量 RRF 融合
RAG_RETRIEVAL_MODE=vector
# 仅 hybrid 模式生效；保留原始 Query，并补充技术关键词/LLM 改写 Query
RAG_QUERY_EXPANSION=false
# 仅 hybrid 模式生效；LLM 仅重排已有候选 ID，异常时保留 RRF 顺序
RAG_RERANK_ENABLED=false
RAG_RERANK_MAX_CANDIDATES=20
# Gitee 令牌：从环境提供（不写死、不提交）；（可选）真实验收时注入
# GITEE_TOKEN=<your-token>
# 测试执行：mock=仅开发/演示（不伪造 Docker 成功）；docker=真实容器执行
TEST_RUNNER_MODE=mock
# 索引代码读取主链用本地 git clone/fetch/worktree（避免 Gitee API 逐文件限流）；关闭则回退 Gitee API（显式标注 gitee_api_fallback）
USE_GIT_CLONE_INDEX=true
# Celery：接真实 Redis 队列时开启，并配置 broker/result backend
USE_CELERY=false
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
