# 团队版环境模板

APP_ENV=team
APP_NAME=enterprise-ai-agent-platform
APP_PORT=8000
PUBLIC_PORT=8002
PUBLIC_BASE_URL=http://<server-ip>:8080
TEAM_PUBLIC_PORT=8080
FRONTEND_CORS_ORIGINS=http://<server-ip>:8080
AUTH_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
AUTH_COOKIE_SECURE=false
DATABASE_NAME=agent_team
TEAM_MYSQL_NETWORK=projectdream_backend_net
REDIS_DB=1
MILVUS_COLLECTION_PREFIX=team
# 管理员应急恢复码，必须替换为部署负责人保管的随机高强度值
AUTH_RECOVERY_CODE=replace-with-a-long-random-recovery-code

# ---- 模型接入（可选，Key 留空则回退本地兜底）----
# 文本大模型：DeepSeek。不配置 LLM_API_KEY 时，AI 分析回退规则生成。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 向量模型：智谱 embedding-3。不配置 ZHIPU_API_KEY 时，Embedding 回退本地 token-hash。
EMBEDDING_PROVIDER=zhipu
ZHIPU_MODEL=embedding-3
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
EMBEDDING_DIMENSIONS=2048
# 通用模型调用参数
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# 团队/生产必须接真实 LLM：false=真实调用；仅开发/演示可置 true=mock 回退（须显式标注）
MODEL_MOCK_FALLBACK=false

# ---- 后端运行时（与 backend/app/core/runtime_config.py 对齐）----
DATA_DIR=.data
# 团队版必须以 MySQL 为业务/审计承载（不允许默认 sqlite；未配 mysql 会启动报错）
DATABASE_URL=mysql+pymysql://user:pass@host:3306/agent_team?charset=utf8mb4
USE_SQLALCHEMY=true
# ---- DB 连接池调优（压测并发建任务顶满默认池 size=5/overflow=10 的修复）----
# 按 worker 数调整：总连接上限 ≈ (DB_POOL_SIZE + DB_MAX_OVERFLOW) × worker 数，不要超过 MySQL max_connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
PERSIST_STRICT=false
USE_MILVUS=true
# 单机低资源部署使用持久化 Milvus Lite；有独立 Milvus 时替换为 http://<private-host>:19530
MILVUS_URI=/var/lib/agent/data/milvus/code_index.db
# MILVUS_TOKEN=<token>
RAG_MOCK_FALLBACK=false   # 团队/生产：Milvus 失败即抛错（不静默降级）；仅开发/演示可置 true=显式降级内存/关键词并标注
# 已通过当前真实标注集评测：团队版使用 BM25 + 向量 RRF 融合。
RAG_RETRIEVAL_MODE=hybrid
# 当前数据集未证明改写可带来额外收益，保持关闭以控制调用时延与成本。
RAG_QUERY_EXPANSION=false
# 当前真实标注集上 rerank 显著改善 Top 1，团队版默认开启；发布前仍须用目标仓库评测集复验。
RAG_RERANK_ENABLED=true
RAG_RERANK_MAX_CANDIDATES=20
# Gitee 令牌：从环境提供（不写死、不提交）；用于 Issue 同步/PR 创建/索引 git 鉴权
# GITEE_TOKEN=<your-token>
# 真实测试执行：docker=在容器跑测试命令（记 exit/stdout/stderr/duration）；mock=仅开发/演示
TEST_RUNNER_MODE=docker
# Docker daemon 在宿主机运行时，必须把容器内 DATA_DIR 映射到 named volume 的宿主机路径。
# 当前 Compose 固定卷名为 agent_team_data；云机默认路径如下，若 Docker 根目录变更需同步调整。
TEST_RUNNER_HOST_DATA_DIR=/var/lib/docker/volumes/agent_team_data/_data
# 索引代码读取主链改用本地 git clone/fetch/worktree（避免 Gitee API 逐文件限流）；关闭则回退 Gitee API（显式标注 gitee_api_fallback）
USE_GIT_CLONE_INDEX=true
# 生产/团队版必须用真实 Celery+Redis（不允许静默 eager）。以下默认开启：
USE_CELERY=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# 多 Worker 必须配置 REDIS_URL 作为分布式锁
REDIS_URL=redis://redis:6379/2
# 在线团队页面实时同步：复用 REDIS_URL；不填时实时层默认复用 Celery Broker
REALTIME_ENABLED=true
REALTIME_REDIS_URL=redis://redis:6379/2
TEST_RUNNER_IMAGE=platform-test-runner:base
TEST_RUNNER_NETWORK=none
TEST_RUNNER_INSTALL_MODE=image
TEST_RUNNER_CPUS=0.50
TEST_RUNNER_MEMORY=384m
TEST_RUNNER_PIDS_LIMIT=128
