# 企业版运行环境模板（deploy/docker-compose.enterprise.yml 使用）
# 说明：
#   - 不包含真实 Token / 密码 / JWT / 恢复码 / 数据库连接串。
#   - 下列 *_SECRET / *_CODE 占位值会被部署启动校验拒绝（backend-entrypoint.sh 与 runtime_config 双保险），
#     必须替换为非占位的随机强值后才能启动。
#   - 数据库 / 密钥 / 凭据由运维在真实环境注入，禁止提交。

# ---- 运行态 ----
APP_ENV=enterprise
APP_NAME=enterprise-ai-agent-platform
APP_PORT=8000
# 公网入口由 compose 的 ENTERPRISE_PUBLIC_PORT 控制，默认 8081（避免团队版 8080）。
# ENTERPRISE_PUBLIC_PORT=8081
PUBLIC_BASE_URL=http://<server-ip>:8081
REDIS_DB=2
DATABASE_NAME=agent_enterprise

# ---- 必填密钥（占位值无法启动，必须替换）----
# ≥32 字符唯一随机值；替换命令示例：openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# ≥16 字符强随机恢复码（部署负责人保管）
AUTH_RECOVERY_CODE=replace-with-a-long-random-recovery-code
# 允许跨域的前端来源（逗号分隔），至少含本栈公网地址
FRONTEND_CORS_ORIGINS=

# ---- MySQL（compose 使用外部网络；此处仅占位，必须替换为真实地址/账号）----
DATABASE_URL=mysql+pymysql://user:pass@mysql:3306/agent_enterprise?charset=utf8mb4
# 企业版必须以 MySQL 为业务/审计承载，禁止 sqlite / 内存回退
USE_SQLALCHEMY=true
PERSIST_STRICT=false

# ---- 队列（compose 内 redis 服务名 redis；独立部署时改为实际地址）----
USE_CELERY=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2

# ---- 向量/检索（企业专用 Milvus；不复用团队版数据）----
USE_MILVUS=true
MILVUS_URI=http://milvus-enterprise:19530
# MILVUS_TOKEN=<token>
MILVUS_COLLECTION_PREFIX=enterprise
ENTERPRISE_MINIO_ROOT_USER=enterprise-minio
ENTERPRISE_MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
RAG_MOCK_FALLBACK=false   # 生产：检索失败即抛错（不静默降级）；仅开发/演示可置 true
RAG_RETRIEVAL_MODE=hybrid
RAG_QUERY_EXPANSION=false
RAG_RERANK_ENABLED=false
RAG_RERANK_MAX_CANDIDATES=20
# E3-07 精确符号定义优先：query token 与 chunk.symbol_name 完全一致时对 bm25/RRF 分数加权，
# 让函数/类定义块排在仅引用该符号的调用块之前（提升代码检索 precision@5/MRR/NDCG，实测 recall 同步不退化；
# 不越权、不回退过滤）。安全默认开启（rank 排序偏好，非安全开关）；置 0.0 关闭。
RAG_SYMBOL_BOOST=1.0
# E3-09 Cross-Encoder 精排（安全默认：关 / 空模型 / cpu；只重排已过滤候选、不发代码正文；
# 模型不可用/超时/异常 → 稳定回退 heuristic，fallback 不冒充 CE）。本地/私有模型运行时优先。
RAG_CROSS_ENCODER_ENABLED=false
RAG_CROSS_ENCODER_MODEL=
RAG_CROSS_ENCODER_DEVICE=cpu
RAG_CROSS_ENCODER_TOP_N=16
RAG_CROSS_ENCODER_BATCH_SIZE=8
RAG_CROSS_ENCODER_TIMEOUT_SECONDS=5
RAG_CROSS_ENCODER_MAX_CANDIDATES=32
RAG_CROSS_ENCODER_FALLBACK=heuristic

# ---- 模型接入（企业真实向量验证必须配置 ZHIPU_API_KEY）----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
EMBEDDING_PROVIDER=zhipu
ZHIPU_MODEL=embedding-3
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
# 先由真实 embedding 探测校验；不匹配时索引创建直接失败，禁止静默改维度。
EMBEDDING_DIMENSIONS=auto
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MOCK_FALLBACK=false   # 生产必须接真实 LLM；仅开发/演示可置 true（须显式标注）

# ---- Gitee / 测试执行 / 索引 ----
# GITEE_TOKEN=<your-token>
# E4 真实 PR/发布证据（仅 scratch 仓库；生产默认关闭）
# E4_PR_PROVIDER=gitee
# E4_PR_REPOSITORY_ID=<authorized-scratch-repository-id>
# ALLOW_SCRATCH_REAL_CHANGE=false
# E2E_REAL_CHANGE_REPO_IDS=<authorized-scratch-repository-id>
# E2E_SCRATCH_REPO_URLS=https://gitee.com/<owner>/<scratch-repository>
# RELEASE_EVIDENCE_DIR=/var/lib/agent/data/enterprise-e4-release
# 可选：固定 E4 PR 基线/头分支；默认按仓库默认分支和 task_id 生成
# E4_PR_BASE_BRANCH=main
# E4_PR_HEAD_BRANCH=
TEST_RUNNER_MODE=docker
USE_GIT_CLONE_INDEX=true
